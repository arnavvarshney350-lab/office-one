{
  "name": "office-one",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "e2e": "playwright test",
    "check": "tsc -b && oxlint && vitest run",
    "e2e:prod": "playwright test -c playwright.prod.config.ts",
    "fonts:update": "node scripts/update-fonts.mjs",
    "verify": "npm run check && npm run e2e && npm run e2e:prod",
    "desktop:build": "node scripts/build-mac.mjs",
    "desktop:icon": "node scripts/make-icon.mjs"
  },
  "dependencies": {
